# Axiom-Saas-Server .env.example
# ============================================================================
# Template for Axiom-Saas-Server runtime env vars. Copy to .env (dev) or
# inject via secrets manager (prod). Defaults shown in code live in:
#   src/config/vibe-trading/vibe-trading.config.ts
#   src/config/ai-agent/ai-agent.config.ts
#   src/config/skill/skill.config.ts
#
# Sections:
#   1. AI Agent  → VibeTrading  (where the actual chat FastAPI runs)
#   2. AI Agent lifecycle / quota
#   3. Skill Plaza  (where the Skill Plaza admin UI / API runs)
#      ↳ Inbound  : browser → /api_group/*  → NestJS  (this service)
#      ↳ Outbound : VibeTrading → https://<nginx>/api_group/api/v1/internal/*
#      ↳ See AxiomVibeTrading/agent/.env.example for the matching outbound
#        side (SKILL_SAAS_*). The two services MUST share a SKILL_SERVICE_TOKEN.
# ============================================================================

# ============ 1. AI Agent → VibeTrading (upstream chat service) ============
# NestJS is the public SaaS layer; the actual chat / streaming / goal / swarm
# runtime lives in AxiomVibeTrading (FastAPI). The ai-agent module forwards
# /sessions/:id/messages, /swarm/*, /goal, /upload to this upstream.
#
# VIBE_TRADING_BASE_URL — base URL of the VibeTrading service.
#   - Same docker network (compose stacks share a network): http://vibe-trading:8899
#   - Cross compose / prod:                              http://<vibe-trading-public-ip>:8899
#   - Default in code (vibe-trading.config.ts:22):       http://106.13.219.178:8899
VIBE_TRADING_BASE_URL=http://vibe-trading:8899

# VIBE_TRADING_API_TOKEN — bearer token NestJS sends on every upstream call.
#   MUST equal the INTERNAL_API_KEY in AxiomVibeTrading/.env (or wherever the
#   FastAPI reads it). Generate with `openssl rand -hex 32`. Default in code
#   is the empty string, which the VibeTrading API rejects with 401/403 —
#   set this explicitly in any non-dev environment.
VIBE_TRADING_API_TOKEN=<internal-api-key-from-vibe-trading>

# VIBE_TRADING_TIMEOUT_MS — per-request timeout (ms) for upstream fetch.
#   Default 60000 (60s). For SSE / streaming routes the streaming response
#   isn't blocked by this — AbortSignal.timeout governs request setup, not
#   stream lifetime.
VIBE_TRADING_TIMEOUT_MS=60000


# ============ 2. AI Agent lifecycle / quota ============
# AI_AGENT_TTL_DAYS — auto-clean sessions idle longer than this.
#   Default 30. Sessions older than ttlDays + ttlGraceDays are GC'd.
AI_AGENT_TTL_DAYS=30

# AI_AGENT_TTL_GRACE_DAYS — buffer after TTL before hard delete (so users
#   can still resume a recent session). Default 7.
AI_AGENT_TTL_GRACE_DAYS=7

# AI_AGENT_DAILY_QUOTA — per-user daily cap on agent runs (counter resets
#   at 00:00 user-local time). Default 50. Bump for power users via the
#   admin UI; this env var is just the default floor.
AI_AGENT_DAILY_QUOTA=50


# ============ 3. Skill Plaza ============
# The Skill Plaza is owned by this service (NestJS). The browser hits
# /api_group/* → NestJS for the admin UI / plaza browse / plaza bind.
# Separately, AxiomVibeTrading calls back into /api/v1/internal/* to load
# each user's enabled bindings before composing the system prompt.

# SKILL_OSS_BUCKET — OSS bucket name for skill artifacts (manifest, files,
#   thumbnails). Default 'axiom'. For dev, point at a dedicated bucket to
#   avoid stepping on prod data.
SKILL_OSS_BUCKET=axiom

# SKILL_SERVICE_TOKEN — bearer token validated by ServiceTokenGuard
#   (src/skills/service-token.guard.ts) on every /api/v1/internal/* call.
#   MUST equal AxiomVibeTrading SKILL_SAAS_SERVICE_TOKEN — see that file's
#   SKILL_SAAS_SERVICE_TOKEN section for the full rationale.
#
#   ★ The current guard implementation is a plain string compare — there is
#   NO auto-expiration, NO JWT, NO TTL. The token is valid indefinitely
#   once set on both sides; you do NOT need a calendar-based rotation
#   schedule. Rotate manually only when you have a concrete reason:
#
#     • token string appeared in logs / commit history / shared screenshot
#     • personnel change on the team that touches this repo
#     • security audit demands N-monthly rotation (then set a calendar
#       reminder; the system itself won't enforce it)
#
#   Recommended for prod: a strong random value, e.g. `openssl rand -hex 32`,
#   stored in your password manager (1Password / Bitwarden / vault), pasted
#   into BOTH this file AND AxiomVibeTrading/agent/.env in lockstep. The
#   dev default "dev-skill-service-token" is committed in the repo so
#   anyone who clones the source knows it — fine if /api/v1/internal/* is
#   only reachable inside your private network, less fine if you ever
#   expose it more broadly.
#
#   Mismatch → 401 on every /api/v1/internal/* call → VibeTrading's
#   list_user_skills fail-softs to [] → agent system prompt has no Plaza
#   skill descriptions → user sees "skill attached but agent ignores it".
#
#   Operational runbook (when you do rotate):
#     1. Generate new token:  openssl rand -hex 32
#     2. Update Axiom-Saas-Server/.env  → SKILL_SERVICE_TOKEN=<new>
#     3. Update AxiomVibeTrading/agent/.env → SKILL_SAAS_SERVICE_TOKEN=<new>
#     4. Restart both:  docker compose restart axiom-saas-server-api vibe-trading
#     5. Verify (from VibeTrading container):
#          docker exec vibe-trading \
#            curl -H "Authorization: Bearer $SKILL_SAAS_SERVICE_TOKEN" \
#                 "$SKILL_SAAS_BASE_URL/api/v1/internal/users/1/skills"
#        → expect HTTP 200 + {"data":[...]}. If you see HTTP 401, one side
#          is still on the old token — check both .env files.
SKILL_SERVICE_TOKEN=<matching-skill-service-token>

# SKILL_MAX_FILE_SIZE_KB — per-file upload limit (KB). Default 256.
SKILL_MAX_FILE_SIZE_KB=256

# SKILL_MAX_TOTAL_SIZE_KB — total upload budget per skill manifest+files
#   (KB). Default 10240 (10 MB). Larger skills should split across multiple
#   files; the cap guards against accidentally uploading a giant PDF.
SKILL_MAX_TOTAL_SIZE_KB=10240

# SKILL_MAX_USER_QUOTA — max enabled skills per user. Default 50. Each
#   user_skill_binding row counts; the cap is enforced at bind time.
SKILL_MAX_USER_QUOTA=50

# SKILL_RESOLVE_TIMEOUT_MS — how long to wait for an OSS fetch when
#   resolving a skill file (manifest, content). Default 500ms. Tighten
#   if your OSS latency is lower; loosen if you see intermittent
#   SkillResolveTimeoutError in NestJS logs.
SKILL_RESOLVE_TIMEOUT_MS=500

# --- Qiniu (S3-compatible) — required for skill artifact storage --------
# The skill.config.ts qiniu block (lines 38-46) reads these. Defaults are
# empty / placeholders, which means skill upload will fail silently until
# filled in. Set ALL of them before going to prod.
#
# QINIU_ACCESS_KEY / QINIU_SECRET_KEY — S3 credential pair. Create in
#   Qiniu console → 对象存储 → 密钥管理.
QINIU_ACCESS_KEY=<qiniu-access-key>
QINIU_SECRET_KEY=<qiniu-secret-key>

# QINIU_BUCKET — bucket name for skill artifacts. Default 'axiom'. Use
#   the same value as SKILL_OSS_BUCKET unless you intentionally split.
QINIU_BUCKET=axiom

# QINIU_DOMAIN — public CDN domain bound to the bucket (no trailing slash).
#   Used to build public URLs for thumbnails / previews.
#   Default in code (skill.config.ts:42): https://<your-cdn-host>
#   ★ DO NOT commit a real CDN host into this template — anyone with git
#     history can see it. Inject via your secrets manager / runtime env.
QINIU_DOMAIN=https://<your-cdn-host>

# QINIU_S3_ENDPOINT — S3-compatible endpoint for the bucket's region.
#   Default: s3-cn-south-1.qiniucs.com (华南). Common alternatives:
#     cn-east-1   → s3-cn-east-1.qiniucs.com   (华东)
#     cn-north-1  → s3-cn-north-1.qiniucs.com  (华北)
#     ap-northeast-1 → s3-ap-northeast-1.qiniucs.com (亚太-东北)
QINIU_S3_ENDPOINT=s3-cn-south-1.qiniucs.com

# QINIU_S3_REGION — region code that matches QINIU_S3_ENDPOINT.
#   Default: cn-south-1.
QINIU_S3_REGION=cn-south-1
# ============================================================================
